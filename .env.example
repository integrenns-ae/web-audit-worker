# Shared-Secret: MUSS gesetzt sein (fail-closed). Muss identisch im Strato-Proxy stehen.
AUDIT_SHARED_SECRET=CHANGE_ME
# Rate-Limits
AUDIT_RATE_HOUR=5
AUDIT_RATE_DAY=15
AUDIT_DOMAIN_COOLDOWN=600
AUDIT_MAX_CONCURRENT=3
# Audit-Laeufe aelter als N Tage automatisch loeschen (fuer compare.py Vorher/Nachher)
AUDIT_RUNS_MAX_AGE_DAYS=360
# Mandanten ausser dem Trichter (Akquise-Agent). Optional: Fehlt die Datei,
# ist nur der Trichter zugelassen. Enthaelt NUR SHA-256-Hashes, nie Klartext.
# Wird beim Start gelesen -> jede Aenderung braucht docker compose restart.
AUDIT_CLIENTS_PATH=/app/clients.json
# Leads an das Vilikon-Cockpit (vilikon.py): jeder Check des Trichters als
# Spur, jede Anfrage zum Check als To-do. Beide leer = aus.
# URL ohne /api/leads (z. B. https://cockpit.example). Den Schluessel vlk_...
# legt Alexander im Cockpit an (Akquise -> Quellen -> Kanal anbinden ->
# Schnittstelle (API)); Quelle ist der Credstore-Eintrag audit-worker-vilikon.
VILIKON_URL=
VILIKON_LEADS_KEY=
